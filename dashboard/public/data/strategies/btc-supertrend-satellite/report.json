{
  "strategyBrief": {
    "plainLanguage": "这是一个以三资产 RiskParity 为核心、用 BTC SuperTrend 趋势信号做小比例卫星增强的组合策略。",
    "objective": "测试一个小比例、带趋势开关的 BTC 卫星仓位，能否在不显著增加回撤和摩擦成本的前提下，给传统资产组合增厚收益。",
    "mechanism": [
      "核心仓位仍由沪深300、纳指100、黄金的 RiskParity 结构承担。",
      "BTC 只作为 5% / 7.5% / 10% 上限的卫星仓位，不是组合主引擎。",
      "当 BTC close 高于 SuperTrend line 时卫星开启，否则卫星仓位进入现金。"
    ],
    "investorUse": "适合用来观察小比例 BTC 趋势增强是否值得进入纸面跟踪，而不是作为单独押注 BTC 的展示页。",
    "watchOut": "如果未来 BTC 趋势收益消失，卫星层可能只增加复杂度和执行摩擦。",
    "glossary": [
      {
        "term": "RiskParity",
        "definition": "按风险贡献而非资金比例来配置沪深300、纳指100和黄金的核心组合。"
      },
      {
        "term": "BTC 卫星",
        "definition": "核心组合之外的小比例增强仓位，用来测试 BTC 趋势收益是否值得承担。"
      },
      {
        "term": "SuperTrend",
        "definition": "以价格和波动率构造的趋势线，价格站上线视为趋势打开，跌破则降低或关闭 BTC 暴露。"
      },
      {
        "term": "纸面跟踪",
        "definition": "先按实盘规则记录信号、成本和成交可行性，但不直接投入真实资金。"
      }
    ]
  },
  "benchmarkScorecard": {
    "title": "评价坐标系",
    "summary": "先用三资产 RiskParity 判断卫星层是否真的增厚组合，再把主动偏股基金、沪深300全收益和纳指100全收益放到同一回测窗口里，帮助投资者理解机会成本、A股Beta和海外成长Beta。",
    "conclusion": "本报告结论基于 2026-06-26 研究快照形成，为静态研究判断；后续 benchmark 刷新不会自动改写本段结论，需要手动生成新的研究快照。结论：BTC7.5%ST卫星年化 19.49%，明显跑赢主动偏股和沪深300全收益，且最大回撤约 -12.75%，相对两条权益参考线回撤明显更浅；但它没有跑赢纳指100全收益 22.01% 的年化。评价上更像是用多资产和 BTC 趋势过滤换取更平滑路径，而不是追求最高进攻收益；BTC10%ST卫星只作进攻观察，默认仍应先纸面跟踪 5% / 7.5%。",
    "period": {
      "startDate": "2016-06-21",
      "endDate": "2026-06-26"
    },
