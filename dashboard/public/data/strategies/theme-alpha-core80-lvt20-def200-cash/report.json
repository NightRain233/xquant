  "strategyBrief": {
    "plainLanguage": "这是一个以三资产核心仓位为底座、用 20% 低波趋势主题 ETF 做卫星增强，并在核心风险恶化时转入现金防御的半月调仓策略。",
    "objective": "观察主题 ETF 增强和 Def200 Cash 防御规则能否在近实盘成本下改善组合路径。",
    "mechanism": [
      "80% 核心仓位由沪深300、纳指100和黄金承担主要资产配置。",
      "20% 卫星仓位在扩展主题 ETF 池内做低波趋势选择。",
      "核心风险恶化时，Def200 Cash 将防御袖转入现金。",
      "固定每月 10 日和 25 日附近生成信号，收盘信号下一交易日执行。"
    ],
    "methodology": [
      {
        "label": "趋势门槛",
        "value": "候选 ETF 价格需要站上 MA60，避免在中期下行趋势里强行买入。"
      },
      {
        "label": "动量门槛",
        "value": "候选 ETF 的 63 日动量需要为正，过滤只低波但没有上涨惯性的资产。"
      },
      {
        "label": "低波筛选",
        "value": "通过趋势和动量门槛后，选择 60 日波动率最低的 3 个资产进入卫星池。"
      },
      {
        "label": "权重约束",
        "value": "入选卫星资产使用 RiskParity 分配，并设置单资产 cap50，避免主题仓位过度集中。"
      }
    ],
    "investorUse": "适合观察多资产配置加主题卫星是否能比单纯买指数或全仓主题轮动更稳。",
    "watchOut": "全仓 LVT 在长样本 proxy 中并不稳定，主题卫星不能升级为主引擎。",
    "glossary": [
      {
        "term": "Core80",
        "definition": "80% 核心仓位，主要承担长期资产配置和组合稳定性。"
      },
      {
        "term": "LVT20",
        "definition": "20% 低波趋势主题卫星，在扩展主题 ETF 池中选择更平滑的趋势暴露。"
      },
      {
        "term": "Def200 Cash",
        "definition": "防御规则；当核心风险状态变差时，将防御袖转入现金。"
      },
      {
        "term": "BIMONTHLY",
        "definition": "固定半月调仓节奏，每月 10 日和 25 日附近生成信号。"
      },
      {
        "term": "proxy",
        "definition": "用于延长样本的代理资产数据，能提供压力测试线索，但不能等同于真实 ETF 历史。"
      }
    ]
  },
  "benchmarkScorecard": {
    "title": "评价坐标系",
    "summary": "Theme Alpha 先和原始三资产核心比较，确认主题卫星和现金防御是否改善路径；再用全仓 LVT 作为风险上限提醒，并把主动偏股基金、沪深300全收益和纳指100全收益放进同一回测窗口里，形成投资者更直观的外部坐标。",
    "conclusion": "本报告结论基于 2026-06-24 研究快照形成，为静态研究判断；后续 benchmark 刷新不会自动改写本段结论，需要手动生成新的研究快照。结论：Core80_LVT20_Def200_Cash 年化 14.48%，明显跑赢主动偏股和沪深300全收益，但年化低于纳指100全收益 17.55%。它的优势在路径：最大回撤约 -11.29%、Calmar 约 1.28，显著好于纳指100全收益约 -35.04% 回撤和 0.50 Calmar。因此默认候选不是最高收益选择，而是更均衡的可跟踪组合；若投资者只接受纳指成长 Beta，Theme Alpha 的吸引力主要来自回撤控制而非收益领先。",
